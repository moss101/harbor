{
  "schema": "harbor.graph/v1",
  "id": "presentation-builder",
  "version": 1,
  "description": "Turn notes into a new slide deck. The model writes the outline — one message per slide, short bullets, speaker notes; deck.verify_outline checks the slide count, one distinct title per slide, bullet counts and lengths, template text and that every number comes from the notes, and a failed check goes back to the model once with the problems listed. deck.build designs the deck — a theme and motion that suit its purpose, and a layout for each slide's content (stats, cards, timeline, comparison, ...) — and proposes the file as a creation batch over the empty base; nothing is saved until the user approves. Improving an existing deck is Deck Review & QA.",
  "inputs": {
    "type": "object",
    "properties": {
      "notes": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000,
        "description": "The material for the deck: notes, figures, points to make."
      },
      "audience": {
        "type": "string",
        "maxLength": 200
      },
      "slides": {
        "type": "integer",
        "minimum": 2,
        "maximum": 10,
        "description": "Optional exact number of content slides (the cover is added)."
      },
      "purpose": {
        "type": "string",
        "enum": [
          "pitch_deck",
          "investor_update",
          "annual_report",
          "board",
          "project_report",
          "status_update",
          "product_launch",
          "quarterly_review",
          "client_proposal",
          "strategy",
          "marketing_plan",
          "training",
          "workshop",
          "case_study",
          "all_hands",
          "keynote",
          "technical_review",
          "impact_report",
          "research",
          "general"
        ],
        "description": "What the deck is for; sets the storyline, theme and motion."
      },
      "theme": {
        "type": "string",
        "enum": [
          "harbor",
          "aurora",
          "ivory",
          "slate",
          "sunrise",
          "obsidian",
          "ocean",
          "forest",
          "midnight_gold",
          "playground",
          "mono",
          "terracotta",
          "royal",
          "blueprint"
        ],
        "description": "Design: layout, shapes and typography (colour is the palette). The purpose picks one when omitted."
      },
      "motion": {
        "type": "string",
        "enum": [
          "none",
          "subtle",
          "dynamic",
          "cinematic"
        ],
        "description": "Slide transitions and animations; the purpose picks one when omitted."
      },
      "rtl": {
        "type": "boolean",
        "description": "Right-to-left deck (Arabic, Hebrew): mirrored layouts."
      },
      "palette": {
        "type": "string",
        "enum": [
          "harbor",
          "aurora",
          "ivory",
          "slate",
          "sunrise",
          "obsidian",
          "ocean",
          "forest",
          "midnight",
          "playground",
          "mono",
          "terracotta",
          "royal",
          "blueprint",
          "graphite",
          "rose",
          "mint",
          "sand",
          "indigo",
          "ember"
        ],
        "description": "Colour palette; any palette suits any theme. The theme's own colours are used when omitted."
      }
    },
    "required": [
      "notes"
    ],
    "additionalProperties": false
  },
  "entry": "brief",
  "budgets": {
    "max_steps": 13,
    "max_tool_calls": 6,
    "max_context_tokens": 26000
  },
  "nodes": [
    {
      "id": "brief",
      "kind": "tool.call",
      "tool": "deck.brief",
      "args": {
        "purpose": {
          "$state": "/input/purpose"
        }
      },
      "out": "/brief",
      "next": "draft"
    },
    {
      "id": "draft",
      "kind": "model.structured",
      "description": "Outline only; the layout is not the model's.",
      "instructions": "Turn the notes into a slide outline for the audience given. One message per slide: a short title that states the point (under 10 words), then two to four short bullets taken from the notes (under 20 words each), and speaker notes with the detail a presenter needs, or null. Every number, name and date must come from the notes; do not add facts, figures or sources the notes do not contain. Do not write a title slide or an agenda: Harbor adds the cover from the deck title and subtitle. When a slide count is given write exactly that many slides, otherwise two to eight. The deck title names the topic; the subtitle may name the audience or the date if the notes give them, otherwise null.",
      "context": [
        {
          "label": "The storyline this kind of deck usually follows (use it as a guide; keep to the notes' facts)",
          "from": "/brief/storyline",
          "optional": true,
          "max_chars": 1600
        },
        {
          "label": "Audience",
          "from": "/input/audience",
          "optional": true
        },
        {
          "label": "Number of slides to write",
          "from": "/input/slides",
          "optional": true
        },
        {
          "label": "Notes",
          "from": "/input/notes",
          "max_chars": 12000
        },
        {
          "label": "Your previous answer was rejected. Write a new answer that fixes every one of these problems",
          "from": "/check/problems",
          "max_chars": 4000,
          "optional": true
        }
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "slides": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "bullets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  }
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 300
                }
              },
              "required": [
                "title",
                "bullets",
                "notes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "subtitle",
          "slides"
        ],
        "additionalProperties": false
      },
      "out": "/outline",
      "max_tokens": 1800,
      "max_retries": 1,
      "next": "check"
    },
    {
      "id": "check",
      "kind": "tool.call",
      "tool": "deck.verify_outline",
      "args": {
        "outline": {
          "$state": "/outline"
        },
        "source": {
          "$state": "/input/notes"
        },
        "slides": {
          "$state": "/input/slides"
        },
        "min_slides": 2,
        "max_slides": 8,
        "max_bullets": 4,
        "max_bullet_words": 22
      },
      "out": "/check",
      "next": "gate"
    },
    {
      "id": "gate",
      "kind": "branch",
      "description": "A failed check goes back to the model once with its problems; a second failure removes what is still unsourced instead of withholding the deck.",
      "cases": [
        {
          "when": {
            "from": "/check/ok",
            "op": "truthy"
          },
          "next": "build"
        }
      ],
      "default": {
        "to": "draft",
        "max_iterations": 1,
        "exhausted": "trim"
      }
    },
    {
      "id": "trim",
      "kind": "tool.call",
      "description": "Last resort after the repair round: drop the bullets, notes and slides that state figures the notes do not give (listed in /outline/removed), then check again.",
      "tool": "deck.drop_unsourced",
      "args": {
        "outline": {
          "$state": "/outline"
        },
        "source": {
          "$state": "/input/notes"
        }
      },
      "out": "/outline",
      "next": "recheck"
    },
    {
      "id": "recheck",
      "kind": "tool.call",
      "tool": "deck.verify_outline",
      "args": {
        "outline": {
          "$state": "/outline"
        },
        "source": {
          "$state": "/input/notes"
        },
        "slides": {
          "$state": "/input/slides"
        },
        "min_slides": 2,
        "max_slides": 8,
        "max_bullets": 4,
        "max_bullet_words": 22
      },
      "out": "/check",
      "next": "gate2"
    },
    {
      "id": "gate2",
      "kind": "branch",
      "description": "What is left must pass the same check; otherwise the user is asked for better notes.",
      "cases": [
        {
          "when": {
            "from": "/check/ok",
            "op": "truthy"
          },
          "next": "build"
        }
      ],
      "default": "unfixable"
    },
    {
      "id": "build",
      "kind": "tool.call",
      "tool": "deck.build",
      "args": {
        "outline": {
          "$state": "/outline"
        },
        "design": {
          "purpose": {
            "$state": "/input/purpose"
          },
          "theme": {
            "$state": "/input/theme"
          },
          "motion": {
            "$state": "/input/motion"
          },
          "rtl": {
            "$state": "/input/rtl"
          },
          "palette": {
            "$state": "/input/palette"
          }
        }
      },
      "out": "/proposal",
      "next": "approve"
    },
    {
      "id": "approve",
      "kind": "approval",
      "description": "A new file is still a protected artifact commit: nothing is written until the user approves and chooses where to save it.",
      "effect_class": "artifact.commit",
      "batch": "/proposal/batch",
      "next_approved": "done",
      "next_rejected": "rejected"
    },
    {
      "id": "done",
      "kind": "end",
      "outcome": "completed",
      "outputs": [
        "/proposal/file_name",
        "/proposal/preview",
        "/proposal/checks",
        "/approvals/approve",
        "/check/warnings",
        "/check/normalized",
        "/outline/removed"
      ]
    },
    {
      "id": "rejected",
      "kind": "end",
      "outcome": "completed",
      "outputs": [
        "/proposal/file_name",
        "/proposal/preview",
        "/approvals/approve"
      ]
    },
    {
      "id": "unfixable",
      "kind": "end",
      "outcome": "needs_input",
      "outputs": [
        "/outline",
        "/check/problems"
      ]
    }
  ]
}
