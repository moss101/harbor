{
  "schema": "harbor.graph/v1",
  "id": "meeting-notes",
  "version": 3,
  "description": "Model proposes, tools verify: the structured model node drafts the minutes; text.verify_items then checks every owner and due date verbatim against the transcript AND that each owner is named next to the action it owns (same line, or the line before a reply). A draft with an unverifiable owner or date goes back to the model once with the problems listed; whatever still cannot be verified is nulled and reported, never guessed. The language is detected by script rather than trusted from the model.",
  "inputs": {
    "type": "object",
    "properties": {
      "transcript": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120000
      },
      "language": {
        "type": "string",
        "maxLength": 16
      }
    },
    "required": [
      "transcript"
    ],
    "additionalProperties": false
  },
  "entry": "minutes",
  "budgets": {
    "max_steps": 10,
    "max_tool_calls": 5,
    "max_context_tokens": 40000
  },
  "nodes": [
    {
      "id": "minutes",
      "kind": "model.structured",
      "instructions": "Turn the transcript into minutes with four parts: a short summary, the decisions taken, the action items, and the open questions. Every owner and due date on an action item must be copied verbatim from the transcript, exactly as written there; never normalize a date or expand a name. When the transcript names no owner or no date for an action, use null for that field instead of a guess. Do not add decisions or actions that were not stated. Write in the language of the meeting unless a target language is given, and report that language as a lowercase ISO 639-1 code such as en or ar.",
      "context": [
        {
          "label": "Target language (if any)",
          "from": "/input/language"
        },
        {
          "label": "Transcript",
          "from": "/input/transcript",
          "max_chars": 60000
        },
        {
          "label": "Your previous answer was rejected. Write a new answer that fixes every one of these problems",
          "from": "/check/problems",
          "max_chars": 3000,
          "optional": true
        },
        {
          "label": "Your previous minutes — keep everything that is right and change only what the problems above name",
          "from": "/minutes",
          "max_chars": 6000,
          "optional": true
        }
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "decisions": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 120
                },
                "due": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                }
              },
              "required": [
                "text",
                "owner",
                "due"
              ],
              "additionalProperties": false
            }
          },
          "open_questions": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        },
        "required": [
          "summary",
          "decisions",
          "actions",
          "open_questions",
          "language"
        ],
        "additionalProperties": false
      },
      "out": "/minutes",
      "max_tokens": 1500,
      "max_retries": 1,
      "next": "verify"
    },
    {
      "id": "verify",
      "kind": "tool.call",
      "description": "Owners and dates must occur verbatim in the transcript, next to the action they belong to.",
      "tool": "text.verify_items",
      "args": {
        "source": {
          "$state": "/input/transcript"
        },
        "items": {
          "$state": "/minutes/actions"
        },
        "fields": [
          "owner",
          "due"
        ],
        "anchor_field": "text",
        "label": "action"
      },
      "out": "/check",
      "next": "gate"
    },
    {
      "id": "gate",
      "kind": "branch",
      "description": "An unverifiable owner or date sends the minutes back once; after that it stays nulled.",
      "cases": [
        {
          "when": {
            "from": "/check/ok",
            "op": "truthy"
          },
          "next": "lang"
        }
      ],
      "default": {
        "to": "minutes",
        "max_iterations": 1,
        "exhausted": "lang"
      }
    },
    {
      "id": "lang",
      "kind": "tool.call",
      "tool": "text.detect_language",
      "args": {
        "text": {
          "$state": "/input/transcript"
        }
      },
      "out": "/language",
      "next": "done"
    },
    {
      "id": "done",
      "kind": "end",
      "outcome": "completed",
      "outputs": [
        "/minutes",
        "/check/results",
        "/language"
      ]
    }
  ]
}
