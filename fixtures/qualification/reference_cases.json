{
  "schema": "harbor.qualification_fixture/v1",
  "purpose": "Known-answer source cases; not runtime PASS evidence",
  "cases": [
    {
      "id": "sum-basic",
      "cells": {
        "A1": 10,
        "A2": 20,
        "A3": 30,
        "B1": "=SUM(A1:A3)"
      },
      "expected": {
        "B1": 60
      }
    },
    {
      "id": "dependency-recalc",
      "cells": {
        "A1": 10,
        "B1": "=A1*2",
        "C1": "=B1+5"
      },
      "edit": {
        "A1": 12
      },
      "expected_after_edit": {
        "B1": 24,
        "C1": 29
      }
    },
    {
      "id": "stale-cache",
      "cells": {
        "A1": 10,
        "B1": "=A1*2"
      },
      "cached_values": {
        "B1": 999
      },
      "expected": {
        "B1": 20
      }
    },
    {
      "id": "zero-division",
      "cells": {
        "A1": 1,
        "B1": "=A1/0"
      },
      "expected_error": {
        "B1": "#DIV/0!"
      }
    },
    {
      "id": "arabic-preservation",
      "paragraph": "تقرير المبيعات",
      "direction": "rtl",
      "expected_text": "تقرير المبيعات"
    },
    {
      "id": "conflict-after-check",
      "schedule": [
        "stage C from A",
        "prepare journal",
        "external writer publishes B",
        "attempt publication C"
      ],
      "expected": "preserve B; conflict or distinct new copy"
    },
    {
      "id": "crash-after-publication",
      "schedule": [
        "prepare journal for C",
        "publish C",
        "crash before DB finalize",
        "recover"
      ],
      "expected": "finalize same version and batch without second publication"
    }
  ]
}
