{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor.invalid/schemas/release_gate.schema.json",
  "title": "Harbor gate result",
  "type": "object",
  "properties": {
    "schema": {
      "const": "harbor.gate_result/v2"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^ACC-[0-9]{3}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "N/A_DISABLED",
        "N/A_PLATFORM",
        "N/A_MILESTONE"
      ]
    },
    "release_descriptor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "build_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "iOS",
            "Android",
            "macOS",
            "Windows"
          ]
        },
        "architecture": {
          "enum": [
            "arm64",
            "arm64-v8a",
            "x64"
          ]
        },
        "os_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "device_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "qualification_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "platform",
        "architecture",
        "os_version",
        "device_class",
        "qualification_profile"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "iOS"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "arm64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "Android"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "arm64-v8a"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "macOS"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "arm64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "Windows"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "architecture": {
                "enum": [
                  "x64",
                  "arm64"
                ]
              }
            }
          }
        }
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(feature|provider):[a-z][a-z0-9_]*$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)[^\\x00-\\x1f]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "path",
          "sha256",
          "test_ids",
          "media_type"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "gate_id",
    "status",
    "release_descriptor_sha256",
    "commit_sha",
    "build_sha256",
    "target",
    "features",
    "evidence",
    "completed_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "BLOCKED",
              "N/A_DISABLED",
              "N/A_PLATFORM",
              "N/A_MILESTONE"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
